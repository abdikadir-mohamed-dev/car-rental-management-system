VITE_API_URL=http://localhost:5000

# Mapbox access token, used for geocoding real-world locations
# (pickup/drop-off addresses, vehicle locations) into map coordinates.
# Get a free token at https://account.mapbox.com/auth/signup/ -- no
# credit card required. Without this set, location lookups fall back
# to central Nairobi.
VITE_MAPBOX_TOKEN=
