SECRET_KEY=dev-secret-key
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crms_db
JWT_SECRET_KEY=jwt-secret-key
FLASK_APP=run.py
FLASK_ENV=development

# Comma-separated list of allowed frontend origins for CORS. If unset,
# falls back to localhost:5173 + the deployed Vercel frontend.
CORS_ORIGINS=

# M-Pesa / Safaricom Daraja
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=
MPESA_PAYMENT_NUMBER=

# Outgoing email (e.g. staff invite emails). If SMTP_HOST is left
# unset, emails are logged instead of sent -- useful for local dev.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=no-reply@drivego.com
